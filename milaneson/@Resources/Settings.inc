; Preferencias del usuario. El Hub reescribe este archivo con !WriteKeyValue.
[Variables]
; es | en  (nombre del archivo en Lang\)
Language=es
; Puerto del servidor web de LibreHardwareMonitor (el Hub lo sincroniza solo)
LHMPort=8085
Accent=130,205,255,255
AccentIndex=0
; Colores de los relojes grandes (el modo adaptativo los ajusta para contrastar con el fondo)
ClockAccent=130,205,255,255
ClockText=255,255,255,220
Use24h=1
ShowSeconds=0
ShowDate=1
BigClockScale1=1.5
BigClockScale2=1
; Tamaño de interfaz: 0 = automático según la resolución
UIScale=0
UIScaleIdx=0
