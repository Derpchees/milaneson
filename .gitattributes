# Rainmeter necesita los .ini/.inc de la skin en UTF-16 LE con BOM.
# Git los guarda como UTF-8 (diffs legibles en GitHub) y los devuelve en UTF-16 al hacer checkout.
milaneson/**/*.ini text working-tree-encoding=UTF-16LE-BOM eol=crlf
milaneson/**/*.inc text working-tree-encoding=UTF-16LE-BOM eol=crlf

*.ps1 text eol=crlf
*.lua text eol=crlf
*.dll binary
